# Only the route this app actually uses. AgentBox overwrites this with
# SecureProxy's virtual key and base URL at `app add` time; it matters only
# when running the app outside AgentBox. There is no Gemini key: the agent is
# built with Google ADK and reaches its model through OpenRouter.
OPENROUTER_API_KEY=

# Optional: the OpenRouter model id (default google/gemini-2.5-flash).
GOOGLE_MODEL=
